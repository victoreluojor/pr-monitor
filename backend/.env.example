# --- Database (Supabase Postgres connection string) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Free-tier source APIs ---
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pr-monitor/1.0
GUARDIAN_API_KEY=
CURRENTS_API_KEY=
HUGGINGFACE_API_KEY=

# --- Alerts (Resend free tier: 3,000 emails/month) ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# --- Ingestion tuning ---
# How many clients get checked per scheduler run (rotation batch size)
INGEST_BATCH_SIZE=2
# Hours between checks for the SAME client
INGEST_ROTATION_HOURS=5
